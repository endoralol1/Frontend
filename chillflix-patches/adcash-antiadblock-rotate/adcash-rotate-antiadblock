#!/bin/bash
set -euo pipefail
DIR="/var/www/chillflix-newsite/public/assets/js"
JSON="/var/www/chillflix-newsite/storage/cache/site-ads.json"
TOOL="/opt/adcash/anti-adblock.sh"
ALPH='abcdefghjkmnpqrstuvwxyz23456789'
NAME=''
for i in 1 2 3 4 5 6 7 8; do
  NAME+=${ALPH:RANDOM%${#ALPH}:1}
done
NAME="${NAME}.js"
NEWPATH="$DIR/$NAME"
NEWSRC="/assets/js/$NAME"

OLDSRC=$(python3 - <<'PY'
import json
print(json.load(open("/var/www/chillflix-newsite/storage/cache/site-ads.json")).get("antiAdblockSrc",""))
PY
)
if [[ "$OLDSRC" == /assets/js/*.js ]]; then
  OLDPATH="$DIR/$(basename "$OLDSRC")"
  if [[ -f "$OLDPATH" ]]; then
    bash "$TOOL" --uninstall "$OLDPATH" >/dev/null || true
    rm -f "$OLDPATH"
  fi
fi

bash "$TOOL" --install "$NEWPATH" 5 >/dev/null
chown www-data:www-data "$NEWPATH"
chmod 644 "$NEWPATH"
if [[ ! -s "$NEWPATH" ]] || [[ $(stat -c%s "$NEWPATH") -lt 1000 ]]; then
  echo '{"ok":false,"message":"Download too small","error":"size"}'
  exit 1
fi

python3 - <<PY
import json, time
from pathlib import Path
p = Path("$JSON")
d = json.loads(p.read_text())
now = int(time.time())
d["antiAdblockSrc"] = "$NEWSRC"
d["antiAdblockRotatedAt"] = now
d["updated"] = now
p.write_text(json.dumps(d, indent=4, ensure_ascii=False) + "\n")
print(json.dumps({
    "ok": True,
    "message": "Rotated anti-adblock library to $NAME",
    "antiAdblockSrc": "$NEWSRC",
    "antiAdblockRotatedAt": now,
    "antiAdblockAutoRotate": bool(d.get("antiAdblockAutoRotate", False)),
    "antiAdblockAutoRotateHours": int(d.get("antiAdblockAutoRotateHours") or 24),
    "antiAdblockAutoRotateMinutes": int(d.get("antiAdblockAutoRotateMinutes") or 1440),
}))
PY
