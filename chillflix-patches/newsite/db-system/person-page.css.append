

/* —— Person / cast profile page —— */
a.cast-item-link {
  color: inherit;
  text-decoration: none;
  transition: transform .18s ease;
}
a.cast-item-link:hover,
a.cast-item-link:focus-visible {
  transform: translateY(-3px);
  outline: none;
}
a.cast-item-link:hover .name,
a.cast-item-link:focus-visible .name {
  color: #fff;
}
a.cast-item-link:hover img,
a.cast-item-link:focus-visible img {
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.45);
  outline: 1px solid rgba(219, 105, 55, 0.6);
}
.person-inline-links a.person-inline-link,
a.person-inline-link {
  color: #e9ecef;
  text-decoration: underline;
  text-decoration-color: rgba(233, 236, 239, 0.35);
  text-underline-offset: 0.15em;
}
.person-inline-links a.person-inline-link:hover,
a.person-inline-link:hover {
  color: #fff;
  text-decoration-color: var(--cf-orange, #db6937);
}

.page-person {
  --person-accent: var(--cf-orange, #db6937);
  background: var(--cf-bg-deep, #10131a);
}
.person-page {
  padding-bottom: 2rem;
}

/* Compact cinematic hero */
.person-stage {
  position: relative;
  padding: 4.4rem 0 1.1rem;
  isolation: isolate;
}
.person-stage-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}
.person-stage-img {
  position: absolute;
  inset: -2%;
  background-size: cover;
  background-position: center 20%;
  filter: saturate(1.05);
}
.person-stage-veil {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(16, 19, 26, 0.55) 0%, rgba(16, 19, 26, 0.72) 45%, var(--cf-bg-deep, #10131a) 100%),
    linear-gradient(90deg, rgba(16, 19, 26, 0.82) 0%, rgba(16, 19, 26, 0.35) 55%, rgba(16, 19, 26, 0.7) 100%);
}
.person-stage-inner {
  position: relative;
  z-index: 1;
}

.person-hero {
  display: flex;
  align-items: flex-start;
  gap: 0.9rem 1.1rem;
}

.person-portrait {
  flex: 0 0 104px;
  width: 104px;
  align-self: flex-start;
}
.person-portrait img {
  display: block;
  width: 104px !important;
  height: 156px !important;
  max-width: 104px !important;
  object-fit: cover !important;
  border-radius: 0.75rem;
  background: #1a1c23;
  border: 2px solid rgba(219, 105, 55, 0.75);
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
}

.person-hero-copy {
  flex: 1 1 auto;
  min-width: 0;
  padding-top: 0.1rem;
}
.person-eyebrow {
  margin: 0 0 0.25rem;
  font-family: Outfit, Poppins, sans-serif;
  font-size: 0.68rem;
  font-weight: 650;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #ffb898;
}
.person-name {
  margin: 0 0 0.4rem;
  font-family: Outfit, Poppins, sans-serif;
  font-size: clamp(1.45rem, 5.2vw, 2.15rem);
  font-weight: 800;
  line-height: 1.12;
  letter-spacing: -0.02em;
  color: #fff;
  text-shadow: 0 6px 22px rgba(0, 0, 0, 0.45);
}
.person-meta-line {
  margin: 0 0 0.35rem;
  color: #d5dae3;
  font-family: Outfit, Poppins, sans-serif;
  font-size: 0.84rem;
  font-weight: 500;
  line-height: 1.35;
}
.person-place {
  display: flex;
  align-items: flex-start;
  gap: 0.25rem;
  margin: 0 0 0.7rem;
  color: rgba(207, 211, 218, 0.78);
  font-family: Outfit, Poppins, sans-serif;
  font-size: 0.8rem;
  line-height: 1.4;
}
.person-place i {
  margin-top: 0.1rem;
  color: rgba(219, 105, 55, 0.85);
  font-size: 0.9rem;
}
.person-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}
.person-action {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.42rem 0.72rem;
  border-radius: 0.5rem;
  border: 1px solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.05);
  color: #e9ecef;
  font-family: Outfit, Poppins, sans-serif;
  font-size: 0.8rem;
  font-weight: 650;
  text-decoration: none;
  transition: background .15s ease, border-color .15s ease, color .15s ease;
}
.person-action:hover {
  border-color: rgba(255, 255, 255, 0.28);
  color: #fff;
  background: rgba(255, 255, 255, 0.1);
}
.person-action.is-primary {
  border-color: transparent;
  background: linear-gradient(135deg, #db6937 0%, #c44d2e 100%);
  color: #fff;
}

.person-body {
  position: relative;
  z-index: 1;
  margin-top: 0.35rem;
}
.person-bio-section {
  margin-bottom: 1.75rem;
}
.person-bio-section .head {
  margin-bottom: 0.65rem;
}
.person-bio-section .body {
  max-width: 42rem;
}
.person-bio {
  margin: 0;
  font-family: Outfit, Poppins, sans-serif;
  font-size: 0.95rem;
  font-weight: 400;
  line-height: 1.75;
  letter-spacing: 0.01em;
  color: #b8c0cd;
}
.person-bio p {
  margin: 0 0 0.85rem;
}
.person-bio p:last-child {
  margin-bottom: 0;
}
.person-bio p:first-child::first-letter {
  font-weight: 600;
  color: #e8edf5;
}
.person-bio.is-clamp {
  display: -webkit-box;
  -webkit-line-clamp: 5;
  -webkit-box-orient: vertical;
  overflow: hidden;
  mask-image: linear-gradient(180deg, #000 62%, transparent 100%);
  -webkit-mask-image: linear-gradient(180deg, #000 62%, transparent 100%);
}
.person-bio.is-open {
  display: block;
  -webkit-line-clamp: unset;
  mask-image: none;
  -webkit-mask-image: none;
  color: #c9d0db;
}
.person-bio-empty {
  margin: 0;
  font-family: Outfit, Poppins, sans-serif;
  color: var(--cf-muted, #9aa3b2);
  font-size: 0.92rem;
  line-height: 1.5;
}
.person-bio-more {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  margin-top: 0.7rem;
  padding: 0;
  border: 0;
  background: none;
  color: #e4e8ef;
  font-family: Outfit, Poppins, sans-serif;
  font-size: 0.86rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  cursor: pointer;
  transition: color .15s ease;
}
.person-bio-more::after {
  content: "";
  width: 0.45rem;
  height: 0.45rem;
  margin-top: 0.05rem;
  border-right: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;
  transform: rotate(45deg);
  opacity: 0.75;
}
.person-bio-more[aria-expanded="true"]::after {
  margin-top: 0.2rem;
  transform: rotate(-135deg);
}
.person-bio-more:hover {
  color: #ffb898;
}

.person-known-for {
  margin-top: 0.25rem;
}
.person-known-grid {
  margin-top: 0.25rem;
}

@media (min-width: 768px) {
  .person-stage {
    padding: 5rem 0 1.4rem;
  }
  .person-hero {
    gap: 1.35rem;
    align-items: center;
  }
  .person-portrait {
    flex-basis: 140px;
    width: 140px;
  }
  .person-portrait img {
    width: 140px !important;
    height: 210px !important;
    max-width: 140px !important;
    border-radius: 0.9rem;
  }
  .person-name {
    font-size: clamp(1.9rem, 3vw, 2.5rem);
  }
  .person-meta-line {
    font-size: 0.95rem;
  }
  .person-bio {
    font-size: 1.02rem;
    line-height: 1.8;
    letter-spacing: 0.012em;
  }
  .person-bio.is-clamp {
    -webkit-line-clamp: 6;
  }
  .person-bio-section .body {
    max-width: 46rem;
  }
}

@media (min-width: 992px) {
  .person-portrait {
    flex-basis: 168px;
    width: 168px;
  }
  .person-portrait img {
    width: 168px !important;
    height: 252px !important;
    max-width: 168px !important;
  }
}
